<?xml version="1.0" encoding="utf-8" ?>
<Patch>          

<!-- Woodworking -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="WoodLog"]</xpath>
    <value>
      <li Class="Discoveries.UnlockResearchOnDiscovery">
        <researchProject>DankPyon_Lumber</researchProject>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="DankPyon_RawWood"]</xpath>
    <value>
      <li Class="Discoveries.UnlockResearchOnDiscovery">
        <researchProject>DankPyon_Lumber</researchProject>
      </li>
    </value>
  </Operation>

<!-- Textile spinning -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="DankPyon_Plant_Flax"]</xpath>
    <value>
      <li Class="Discoveries.UnlockResearchOnDiscovery">
        <researchProject>DankPyon_TextileSpinning</researchProject>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Plant_Cotton"]</xpath>
    <value>
      <li Class="Discoveries.UnlockResearchOnDiscovery">
        <researchProject>DankPyon_TextileSpinning</researchProject>
      </li>
    </value>
  </Operation>


  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Progression: Agriculture</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="DankPyon_Sugarcane"]</xpath>
          <value>
            <li Class="Discoveries.UnlockResearchOnDiscovery"><researchProject>Ferny_Millstone</researchProject></li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="DankPyon_RawWheat"]</xpath>
          <value>
            <li Class="Discoveries.UnlockResearchOnDiscovery"><researchProject>Ferny_Millstone</researchProject></li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Progression: Storage</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="DankPyon_RusticChest"]</xpath>
          <value>
            <li Class="Discoveries.UnlockResearchOnDiscovery"><researchProject>Ferny_Strongbox</researchProject></li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="DankPyon_MetalStrongbox"]</xpath>
          <value>
            <li Class="Discoveries.UnlockResearchOnDiscovery"><researchProject>Ferny_RoyalChest</researchProject></li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>