<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Factions Expanded - Medieval 2</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="Hay"]</xpath>
          <value>
            <li Class="Discoveries.UnlockResearchOnDiscovery"><researchProject>Ferny_Hayweave</researchProject></li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="SmokeleafLeaves"]</xpath>
          <value>
            <li Class="Discoveries.UnlockResearchOnDiscovery"><researchProject>Ferny_Hardweave</researchProject></li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
